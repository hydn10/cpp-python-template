{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "MYLIB_BUILD_APPS": "ON",
        "MYLIB_BUILD_EXAMPLES": "ON",
        "MYLIB_BUILD_PYTHON": "OFF",
        "MYLIB_BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "debug",
      "inherits": "native",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "quality",
      "displayName": "quality",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "$<IF:$<PLATFORM_ID:Windows>,clang-tidy;--warnings-as-errors=*;--extra-arg=/EHsc,clang-tidy;--warnings-as-errors=*>",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "python-dev",
      "displayName": "python-dev",
      "inherits": "quality",
      "cacheVariables": {
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "MYLIB_BUILD_PYTHON": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "release",
      "inherits": "native",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "shared-release",
      "displayName": "shared-release",
      "inherits": "native",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "quality",
      "configurePreset": "quality"
    },
    {
      "name": "python-dev",
      "configurePreset": "python-dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "shared-release",
      "configurePreset": "shared-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "python-dev",
      "configurePreset": "python-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "shared-release",
      "configurePreset": "shared-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}

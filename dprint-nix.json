{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "extends": "./dprint.json",
  "includes": ["**/*.nix"],
  "exec": {
    "associations": ["**/*.nix"],
    "commands": [
      {
        "command": "nixfmt --filename {{file_path}}",
        "exts": ["nix"],
        "cacheKeyFiles": ["flake.lock"]
      }
    ]
  }
}
